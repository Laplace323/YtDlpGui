<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YtDlpGui.ViewModels"
    mc:Ignorable="d"
    x:Class="YtDlpGui.Views.SettingsView"
    x:Name="Root"
    x:DataType="vm:SettingsViewModel">

    <ScrollViewer>

        <Grid
            Margin="30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="20">

            <!-- ================================================== -->
            <!-- ヘッダー -->
            <!-- ================================================== -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="15">

                <Button
                    Grid.Column="0"
                    Content="← 戻る"
                    Command="{Binding BackCommand}"
                    Padding="15,8"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Grid.Column="1"
                    Spacing="3">

                    <TextBlock
                        Text="設定"
                        FontSize="30"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="yt-dlp GUI の動作設定"
                        FontSize="14"
                        Opacity="0.65"/>

                </StackPanel>

            </Grid>


            <!-- ================================================== -->
            <!-- ダウンロード設定 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="1"
                Padding="20"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnDefinitions="160,*"
                    RowSpacing="14"
                    ColumnSpacing="15">

                    <TextBlock
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="ダウンロード"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Margin="0,0,0,5"/>


                    <!-- 画質 -->

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="デフォルト画質"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding QualityOptions}"
                        SelectedItem="{Binding SelectedQuality}"
                        Width="240"
                        HorizontalAlignment="Left"/>


                    <!-- 音質 -->

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="デフォルト音質"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemsSource="{Binding AudioQualityOptions}"
                        SelectedItem="{Binding SelectedAudioQuality}"
                        Width="240"
                        HorizontalAlignment="Left"/>


                    <!-- 形式 -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Text="デフォルト形式"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        ItemsSource="{Binding FormatOptions}"
                        SelectedItem="{Binding SelectedFormat}"
                        Width="240"
                        HorizontalAlignment="Left"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- 保存・メタデータ -->
            <!-- ================================================== -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="20">


                <!-- ================================================== -->
                <!-- 保存設定 -->
                <!-- ================================================== -->

                <Border
                    Grid.Column="0"
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="14">

                        <TextBlock
                            Grid.Row="0"
                            Text="保存"
                            FontSize="19"
                            FontWeight="SemiBold"/>


                        <!-- 保存先 -->

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <TextBox
                                Grid.Column="0"
                                Text="{Binding OutputDirectory}"
                                Watermark="デフォルト保存先"
                                Padding="10"/>

                            <Button
                                Grid.Column="1"
                                Content="参照..."
                                Command="{Binding BrowseCommand}"
                                Padding="15,8"/>

                        </Grid>


                        <!-- プレイリスト -->

                        <CheckBox
                            Grid.Row="2"
                            Content="プレイリストごとにフォルダーを作成"
                            IsChecked="{Binding PlaylistFolderEnabled}"/>

                    </Grid>

                </Border>


                <!-- ================================================== -->
                <!-- メタデータ・字幕 -->
                <!-- ================================================== -->

                <Border
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Text="メタデータ・字幕"
                            FontSize="19"
                            FontWeight="SemiBold"/>


                        <CheckBox
                            Content="サムネイルを保存"
                            IsChecked="{Binding ThumbnailEnabled}"/>


                        <CheckBox
                            Content="字幕を保存"
                            IsChecked="{Binding SubtitleEnabled}"/>


                        <CheckBox
                            Content="自動生成字幕を使用"
                            IsChecked="{Binding AutoGeneratedSubtitleEnabled}"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================== -->
            <!-- ファイル名 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="3"
                Padding="20"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnDefinitions="160,*"
                    RowSpacing="12"
                    ColumnSpacing="15">

                    <TextBlock
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="ファイル名"
                        FontSize="19"
                        FontWeight="SemiBold"/>


                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="ファイル名テンプレート"
                        VerticalAlignment="Center"/>


                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding FileNameTemplate}"
                        Watermark="%(title)s.%(ext)s"
                        Padding="10"/>


                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="例: %(title)s.%(ext)s"
                        FontSize="12"
                        Opacity="0.6"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- ツール -->
            <!-- ================================================== -->

            <Border
                Grid.Row="4"
                Padding="20"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="140,*,Auto"
                    RowSpacing="12"
                    ColumnSpacing="15">

                    <Grid
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        ColumnDefinitions="*,Auto">

                        <TextBlock
                            Grid.Column="0"
                            Text="ツール"
                            FontSize="19"
                            FontWeight="SemiBold"/>

                        <Button
                            Grid.Column="1"
                            Content="再確認"
                            Command="{Binding RefreshToolsCommand}"
                            Padding="12,6"/>

                    </Grid>


                    <!-- yt-dlp -->

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="yt-dlp"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding YtDlpVersion}"
                            Opacity="0.75"/>

                        <TextBlock
                            Text="{Binding YtDlpUpdateStatus}"
                            FontSize="12"
                            Opacity="0.6"/>

                    </StackPanel>

                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="更新"
                        Command="{Binding UpdateYtDlpCommand}"
                        Padding="15,7"/>


                    <!-- FFmpeg -->

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="FFmpeg"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Vertical"
                        Spacing="2"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding FfmpegVersion}"
                            Opacity="0.75"/>

                        <TextBlock
                            Text="{Binding FfmpegUpdateStatus}"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Content="更新"
                        Command="{Binding UpdateFfmpegCommand}"
                        Padding="15,7"/>


                    <!-- FFprobe -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Text="FFprobe"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="{Binding FfprobeVersion}"
                        VerticalAlignment="Center"
                        Opacity="0.75"/>


                    <!-- Deno -->

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Text="Deno"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding DenoVersion}"
                            Opacity="0.75"/>

                        <TextBlock
                            Text="{Binding DenoUpdateStatus}"
                            FontSize="12"
                            Opacity="0.6"/>

                    </StackPanel>

                    <Button
                        Grid.Row="4"
                        Grid.Column="2"
                        Content="更新"
                        Command="{Binding UpdateDenoCommand}"
                        Padding="15,7"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- 下部 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="5"
                Padding="15"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            Text="{Binding StatusText}"
                            Opacity="0.7"/>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <ProgressBar
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Progress}"
                                Height="6"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding ProgressText}"
                                FontSize="12"
                                Opacity="0.6"/>

                        </Grid>

                    </StackPanel>


                    <Button
                        Grid.Column="1"
                        Classes="danger"
                        Content="初期値に戻す"
                        Command="{Binding ResetCommand}"
                        Padding="15,9"
                        VerticalAlignment="Center"/>


                    <Button
                        Grid.Column="2"
                        Classes="primary"
                        Content="設定を保存"
                        Command="{Binding SaveCommand}"
                        Padding="20,9"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YtDlpGui.ViewModels"
    xmlns:models="using:YtDlpGui.Models"
    mc:Ignorable="d"
    x:Class="YtDlpGui.Views.MainView"
    x:Name="Root"
    x:DataType="vm:MainViewModel">

    <ScrollViewer>

        <Grid
            Margin="30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="20">

            <!-- ================================================== -->
            <!-- タイトル -->
            <!-- ================================================== -->

            <StackPanel
                Grid.Row="0"
                Spacing="4">

                <TextBlock
                    Text="yt-dlp GUI"
                    FontSize="30"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="動画・音声ダウンロード"
                    FontSize="14"
                    Opacity="0.65"/>

            </StackPanel>


            <!-- ================================================== -->
            <!-- URL入力 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="1"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="12">

                    <TextBlock
                        Grid.Row="0"
                        Text="ダウンロードURL"
                        FontSize="16"
                        FontWeight="SemiBold"/>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <TextBox
                            Grid.Column="0"
                            Text="{Binding Url}"
                            Watermark="YouTube URLを入力してください（複数URLは改行）"
                            FontSize="15"
                            Padding="12"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="80"
                            MaxHeight="160"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                        <Button
                            Grid.Column="1"
                            Classes="primary"
                            Content="キューに追加"
                            Command="{Binding AddToQueueCommand}"
                            Padding="25,12"
                            VerticalAlignment="Top"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- ダウンロード設定 + 保存場所 -->
            <!-- ================================================== -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="20">


                <!-- ================================================== -->
                <!-- ダウンロード設定 -->
                <!-- ================================================== -->

                <Border
                    Grid.Column="0"
                    Padding="18"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnDefinitions="120,*"
                        RowSpacing="14"
                        ColumnSpacing="12">

                        <!-- タイトル -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="ダウンロード設定"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>


                        <!-- 画質 -->

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="画質"
                            VerticalAlignment="Center"/>

                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding QualityOptions}"
                            SelectedItem="{Binding SelectedQuality}"
                            HorizontalAlignment="Stretch"/>


                        <!-- 音質 -->

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="音質"
                            VerticalAlignment="Center"/>

                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            ItemsSource="{Binding AudioQualityOptions}"
                            SelectedItem="{Binding SelectedAudioQuality}"
                            HorizontalAlignment="Stretch"/>


                        <!-- 保存形式 -->

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="保存形式"
                            VerticalAlignment="Center"/>

                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{Binding FormatOptions}"
                            SelectedItem="{Binding SelectedFormat}"
                            HorizontalAlignment="Stretch"/>


                        <!-- サムネイル -->

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Text="サムネイル"
                            VerticalAlignment="Center"/>

                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Content="サムネイルを保存"
                            IsChecked="{Binding ThumbnailEnabled}"
                            VerticalAlignment="Center"/>


                        <!-- 字幕 -->

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="字幕"
                            VerticalAlignment="Center"/>

                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="1"
                            Spacing="6">

                            <CheckBox
                                Content="字幕を保存"
                                IsChecked="{Binding SubtitleEnabled}"/>

                            <CheckBox
                                Content="自動生成字幕を使用"
                                IsChecked="{Binding AutoGeneratedSubtitleEnabled}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================== -->
                <!-- 保存場所 -->
                <!-- ================================================== -->

                <Border
                    Grid.Column="1"
                    Padding="18"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                    <Grid
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="14">

                        <!-- タイトル -->

                        <TextBlock
                            Grid.Row="0"
                            Text="保存場所"
                            FontSize="16"
                            FontWeight="SemiBold"/>


                        <!-- 保存先 -->

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <TextBox
                                Grid.Column="0"
                                Text="{Binding OutputDirectory}"
                                Watermark="保存先フォルダー"
                                Padding="10"
                                VerticalContentAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="参照..."
                                Command="{Binding BrowseCommand}"
                                Padding="18,10"/>

                        </Grid>


                        <!-- 説明 -->

                        <TextBlock
                            Grid.Row="2"
                            Text="プレイリストの場合は、プレイリスト名のフォルダーを自動作成します。"
                            TextWrapping="Wrap"
                            Opacity="0.6"
                            FontSize="12"
                            VerticalAlignment="Top"/>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================== -->
            <!-- ダウンロードキュー -->
            <!-- ================================================== -->

            <Border
                Grid.Row="3"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    RowDefinitions="Auto,*"
                    RowSpacing="14">


                    <!-- キュータイトル -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">

                        <TextBlock
                            Grid.Column="0"
                            Text="ダウンロードキュー"
                            FontSize="18"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>


                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="primary"
                            Content="キュー開始"
                            Command="{Binding StartQueueCommand}"
                            Padding="18,8"/>


                        <Button
                            Grid.Column="2"
                            Classes="danger"
                            Content="全体キャンセル"
                            Command="{Binding CancelQueueCommand}"
                            Padding="18,8"/>


                        <Button
                            Grid.Column="3"
                            Classes="danger"
                            Content="クリア"
                            Command="{Binding ClearQueueCommand}"
                            Padding="18,8"/>

                    </Grid>


                    <!-- キュー一覧 -->

                    <Border
                        Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        CornerRadius="6">

                        <ScrollViewer
                            MaxHeight="400"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">

                            <ItemsControl
                                ItemsSource="{Binding DownloadQueue}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="models:DownloadQueueItem">

                                        <Border
                                            Classes="queueItem"
                                            Padding="14"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                RowDefinitions="Auto,Auto,Auto,Auto"
                                                ColumnSpacing="18"
                                                RowSpacing="6">


                                                <!-- ================================================== -->
                                                <!-- 左側 -->
                                                <!-- ================================================== -->

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="{Binding Title}"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"/>


                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="{Binding Url}"
                                                    FontSize="12"
                                                    Opacity="0.5"
                                                    TextTrimming="CharacterEllipsis"/>


                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="12">

                                                    <TextBlock
                                                        Text="{Binding Quality, StringFormat='画質: {0}'}"
                                                        FontSize="12"
                                                        Opacity="0.7"/>

                                                    <TextBlock
                                                        Text="{Binding AudioQuality, StringFormat='音質: {0}'}"
                                                        FontSize="12"
                                                        Opacity="0.7"/>

                                                    <TextBlock
                                                        Text="{Binding Format, StringFormat='形式: {0}'}"
                                                        FontSize="12"
                                                        Opacity="0.7"/>

                                                </StackPanel>


                                                <!-- 進捗 -->

                                                <ProgressBar
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding Progress}"
                                                    Height="8"
                                                    Margin="0,4,0,0"/>


                                                <!-- ================================================== -->
                                                <!-- 右側 -->
                                                <!-- ================================================== -->

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.RowSpan="4"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Spacing="6">


                                                    <Border
                                                        Classes="statusBadge"
                                                        Classes.waiting="{Binding IsWaiting}"
                                                        Classes.downloading="{Binding IsDownloading}"
                                                        Classes.completed="{Binding IsCompleted}"
                                                        Classes.error="{Binding HasError}"
                                                        HorizontalAlignment="Right">

                                                        <TextBlock
                                                            Text="{Binding Status}"/>

                                                    </Border>


                                                    <TextBlock
                                                        Text="{Binding ProgressText}"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Opacity="0.7"/>


                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="5">

                                                        <Button
                                                            Content="再試行"
                                                            Padding="10,5"
                                                            Command="{Binding #Root.DataContext.RetryQueueItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding HasError}"/>

                                                        <Button
                                                            Classes="danger"
                                                            Content="削除"
                                                            Padding="10,5"
                                                            Command="{Binding #Root.DataContext.RemoveQueueItemCommand}"
                                                            CommandParameter="{Binding}"/>

                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- 全体進捗 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="4"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <StackPanel
                    Spacing="8">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding StatusText}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding ProgressText}"
                            FontWeight="SemiBold"/>

                    </Grid>

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Progress}"
                        Height="12"/>

                </StackPanel>

            </Border>


            <!-- ================================================== -->
            <!-- エラー -->
            <!-- ================================================== -->

            <Border
                Grid.Row="5"
                IsVisible="{Binding HasError}"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <StackPanel
                        Grid.Column="0"
                        Spacing="6">

                        <TextBlock
                            Text="エラー詳細"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBox
                            Text="{Binding ErrorMessage}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MaxHeight="180"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VerticalContentAlignment="Top"/>

                    </StackPanel>


                    <Button
                        Grid.Column="1"
                        Content="エラーをコピー"
                        Command="{Binding CopyErrorCommand}"
                        VerticalAlignment="Top"
                        Padding="15,8"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- ステータス -->
            <!-- ================================================== -->

            <Border
                Grid.Row="6"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="15">

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ToolStatus}"
                        Opacity="0.65"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"/>

                    <Button
                        Grid.Column="1"
                        Content="設定"
                        Command="{Binding SettingsCommand}"
                        Padding="20,9"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- 下部余白 -->
            <!-- ================================================== -->

            <Border
                Grid.Row="7"
                Height="1"/>

        </Grid>

    </ScrollViewer>

</UserControl>